{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe-import-v1.schema.json",
  "title": "Points Tracker recipe import version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "foods", "recipe"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "recipe-import" },
    "foods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/recipeFood" }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "servings", "ingredients"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "servings": { "type": "number", "exclusiveMinimum": 0 },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["foodImportKey", "quantity", "unit"],
            "properties": {
              "foodImportKey": { "type": "string", "minLength": 1, "maxLength": 80 },
              "quantity": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "enum": ["g", "ml", "each"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "grams"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 100 },
        "grams": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protein", "carbohydrate", "fat", "fibre"],
      "properties": {
        "protein": { "type": "number", "minimum": 0 },
        "carbohydrate": { "type": "number", "minimum": 0 },
        "fat": { "type": "number", "minimum": 0 },
        "fibre": { "type": "number", "minimum": 0 }
      }
    },
    "recipeFood": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["importKey", "name", "brand", "source", "nutritionPer100g", "servings"],
          "properties": {
            "importKey": { "$ref": "#/$defs/importKey" },
            "name": { "$ref": "#/$defs/name" },
            "brand": { "$ref": "#/$defs/brand" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "external-json" } }
            },
            "nutritionPer100g": { "$ref": "#/$defs/nutrition" },
            "servings": { "$ref": "#/$defs/servings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["importKey", "name", "brand", "source", "servings"],
          "properties": {
            "importKey": { "$ref": "#/$defs/importKey" },
            "name": { "$ref": "#/$defs/name" },
            "brand": { "$ref": "#/$defs/brand" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "foodId"],
              "properties": {
                "kind": { "const": "afcd" },
                "foodId": { "type": "string", "minLength": 1, "maxLength": 100 }
              }
            },
            "nutritionPer100g": { "$ref": "#/$defs/nutrition" },
            "servings": { "$ref": "#/$defs/servings" }
          }
        }
      ]
    },
    "importKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "brand": { "type": ["string", "null"], "maxLength": 160 },
    "servings": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/serving" } }
  }
}
